{
  "permissions": {
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-lua.sh\"; [ ! -f \"$f\" ] || sh \"$f\"",
            "statusMessage": "Formatting Lua"
          }
        ]
      }
    ]
  }
}
