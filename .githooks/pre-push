#!/bin/sh
# Refuse a push that would move `main` on a remote. Why main is off limits is
# in AGENTS.md, under "Landing a change", along with the two lines that
# install this.
#
# Whatever produced the commits -- `git commit`, a merge, a cherry-pick, a
# revert, a rebase, a reset -- this is the one place every one of them has to
# pass to reach the branch other people read, which is what makes it the half
# of the pair that cannot be walked around by reaching for a different verb.
#
# The ruleset on `main` refuses the same push at the server, for everyone and
# with nothing to install -- `current_user_can_bypass` reads `never` even for
# the owner. What this keeps is the half the server has no way to give: it
# refuses before the round trip, and it prints how to undo what is already
# committed, which GitHub's own refusal does not.

case "$SUPALINE_PUSH_TO_MAIN" in
"" | 0 | false | no) ;;
*) exit 0 ;;
esac

# Only for this repository. A fork's `main` is the contributor's own branch --
# syncing it from upstream and pushing it is an ordinary thing to do -- and
# refusing that is none of this repository's business. Publication is what made
# the distinction real: before it there were no forks to get this wrong for.
# An unreadable remote falls through to the refusal rather than past it.
#
# GitHub answers the same repository under more than one spelling -- any case,
# a trailing slash, `.git` or not, all measured over HTTPS -- and documents SSH
# on port 443 at `ssh.github.com` besides, so the URL is folded to one before it
# is compared. The character in front of `github.com` is what keeps out a host
# that merely ends in it.
remote_url=${2:-unknown}
remote_url=$(printf '%s' "$remote_url" | tr '[:upper:]' '[:lower:]')
remote_url=${remote_url%/}
case "${remote_url%.git}" in
unknown | *[/@.]github.com[:/]yohkuri/supaline.yazi) ;;
*[/@.]github.com:443/yohkuri/supaline.yazi) ;;
*) exit 0 ;;
esac

refused=
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	refs/heads/main) refused=1 ;;
	esac
done
[ -n "$refused" ] || exit 0

cat >&2 <<'MSG'
supaline: refusing a push to `main`.

  main moves when a pull request is merged, and not otherwise. `Commit
  messages` in .github/workflows/check.yml -- commitlint, the ASCII header,
  the Gitmoji test -- runs on a pull request alone, so a commit that reaches
  main another way is one nothing read.

  Push the branch and open one:

      git push -u origin HEAD
      gh pr create

  Then bring main across:

      git switch main && git pull --ff-only

  A deliberate exception is spelled out rather than bypassed wholesale:

      SUPALINE_PUSH_TO_MAIN=1 git push ...
MSG
exit 1
